# JWT (générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=5603cf4444f24e459197b9b0da3db4af079c53003b6df10a09b8b246c046bcb09ee90514da04bbb34eef0cba10c31c45918936250bc9cd4154d73a998dc4bf6b
