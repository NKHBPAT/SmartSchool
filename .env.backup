# Redis (sessions, rate limiting, cache)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
SESSION_TTL_SECONDS=28800

# Sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=50

# Frontend URL (CORS)
FRONTEND_URL=https://smartschool.cm
FRONTEND_URL_WWW=https://www.smartschool.cm

# Upload fichiers (logos, photos)
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
ALLOWED_IMG_TYPES=image/jpeg,image/png,image/webp

# Stockage cloud (optionnel — sinon fichiers locaux)
