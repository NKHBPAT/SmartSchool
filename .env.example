# ============================================================
# SmartSchool Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env dans git !
# ============================================================

NODE_ENV=production
PORT=3000

# Base de données PostgreSQL
DATABASE_URL=postgresql://smartschool_user:VOTRE_MOT_DE_PASSE@localhost:5432/smartschool_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartschool_db
DB_USER=smartschool_user
DB_PASSWORD=VOTRE_MOT_DE_PASSE_FORT
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT (générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE_256_BITS
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=REMPLACER_PAR_UNE_AUTRE_CLE_ALEATOIRE
JWT_REFRESH_EXPIRES_IN=7d

# Redis (sessions, rate limiting, cache)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
SESSION_TTL_SECONDS=28800

# Sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Frontend URL (CORS)
FRONTEND_URL=https://smartschool.cm
FRONTEND_URL_WWW=https://www.smartschool.cm

# Upload fichiers (logos, photos)
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
ALLOWED_IMG_TYPES=image/jpeg,image/png,image/webp

# Stockage cloud (optionnel — sinon fichiers locaux)
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# CLOUDFLARE_R2_BUCKET=

# SMS — Orange Cameroun
ORANGE_SMS_ENABLED=false
ORANGE_SMS_API_URL=https://api.orange.com/smsmessaging/v1
ORANGE_SMS_TOKEN=
ORANGE_SMS_FROM=+237XXXXXXXXX

# SMS — MTN Cameroun
MTN_SMS_ENABLED=false
MTN_SMS_API_URL=
MTN_SMS_API_KEY=
MTN_SMS_FROM=

# SMS — Twilio (international)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX

# Email (notifications, récupération de mot de passe)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@smartschool.cm
SMTP_PASSWORD=
EMAIL_FROM=SmartSchool <noreply@smartschool.cm>

# Logs
LOG_LEVEL=info
LOG_DIR=./logs

# Admin système par défaut (créé lors du premier seed)
ADMIN_EMAIL=admin@smartschool.cm
ADMIN_PASSWORD=Admin@2025
ADMIN_NAME=Herman SmartSchool
